<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TvLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 全屏、无状态栏、无导航栏：桌面/电视必须 -->
    <style name="Theme.TvLauncher.Fullscreen" parent="Theme.TvLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- 主界面卡片标题 -->
    <style name="TileTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/tile_title_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 底部 Dock 文字 -->
    <style name="DockTitle">
        <item name="android:textColor">@color/dock_text</item>
        <item name="android:textSize">@dimen/dock_text_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
