<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片和底栏按钮由 MainActivity 填充。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="30dp">

        <!-- 状态栏 -->
        <FrameLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="@dimen/status_padding_h"
            android:paddingEnd="@dimen/status_padding_h">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/status_usb"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/status_usb"
                    android:src="@drawable/ic_status_usb" />

                <ImageView
                    android:id="@+id/status_wifi"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/status_wifi"
                    android:src="@drawable/ic_status_wifi" />

                <TextView
                    android:id="@+id/status_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/status_text_size"
                    android:text="8:08 AM" />

                <TextView
                    android:id="@+id/status_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/status_text_size"
                    android:text="Saturday,November 11" />
            </LinearLayout>
        </FrameLayout>

        <!-- 应用卡片 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/tile_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- 底栏 -->
        <LinearLayout
            android:id="@+id/dock_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
