<?xml version="1.0" encoding="utf-8"?>
<!-- 应用列表项：普通 / 聚焦 两态 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/list_item_bg_focus" />
            <stroke
                android:width="3dp"
                android:color="@color/list_item_stroke_focus" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/list_item_bg_focus" />
            <stroke
                android:width="3dp"
                android:color="@color/list_item_stroke_focus" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/list_item_bg" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
